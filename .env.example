# Kriz ve Afet Yönetimi Karar Destek Sistemi — ortam değişkenleri şablonu
#
# Bu dosyayı `.env` olarak kopyalayıp GERÇEK değerleri girin:
#     cp .env.example .env
#
# `.env` dosyası GİT'E ASLA COMMIT EDİLMEMELİDİR (.gitignore'a eklenmiştir);
# içinde gerçek Neo4j parolası gibi sırlar bulunur. Bu şablon dosyasında
# YER TUTUCU (placeholder) değerlerden başka bir şey YOKTUR.
#
# docker-compose.yml bu dosyayı (adı `.env` olduğunda) OTOMATİK okur ve
# hem `neo4j` konteynerinin başlangıç parolasını hem de `app` konteynerinin
# bağlantı bilgilerini buradan alır — tek bir kaynak, iki taraf.

# --- Neo4j ---------------------------------------------------------------
# docker-compose ile çalışırken servis adı `neo4j` kullanılır (Docker DNS);
# yerel (konteynersiz) geliştirmede localhost kullanın.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# En az 8 karakter — Neo4j 5+/6+ bu kuralı zorunlu kılar.
NEO4J_PASSWORD=degistir_bu_sifreyi_123
NEO4J_DATABASE=neo4j

# --- Ollama (LLM) ----------------------------------------------------------
# docker-compose ile çalışırken servis adı `ollama` kullanılır.
OLLAMA_BASE_URL=http://ollama:11434
# İKİ AYRI GÖREV, İKİ AYRI MODEL (bkz. `api.py`daki `get_parser`/`get_engine`):
# ikisini AYNI modele ayarlamak, `OllamaParser` JSON çıkarımını dar-görevli
# bir modelle kırabilir.
# Metin -> Bilgi Grafı (JSON varlık çıkarımı) — genel amaçlı model.
OLLAMA_EXTRACTION_MODEL=llama3
# Bilgi Grafı -> taktiksel öneri metni — Türkçe dilbilgisi/tutarlılık
# açısından güçlü, çok-dilli bir taban model önerilir (ör. qwen2.5); "Kurmay"
# kişiliği (bkz. proje kökü `Modelfile.qwen`) bir Ollama SYSTEM prompt'u
# olarak eklenir, ayrı bir fine-tune GEREKTİRMEZ.
OLLAMA_TACTICAL_MODEL=karavul-kurmay-qwen
